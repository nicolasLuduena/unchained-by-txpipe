# local or fuji. Selects deployments/<chain>.json and the RPC.
NEXT_PUBLIC_CHAIN=local
# Optional. Overrides the chain's default RPC.
# NEXT_PUBLIC_RPC_URL=
# Optional. Overrides the 0xGasless bundler on fuji.
# NEXT_PUBLIC_BUNDLER_URL=
# Required on fuji: the smart-account contracts. Values are in spike/README.md, "Fuji addresses".
# NEXT_PUBLIC_AA_FACTORY=
# NEXT_PUBLIC_AA_IMPLEMENTATION=
# NEXT_PUBLIC_AA_FALLBACK_HANDLER=
# NEXT_PUBLIC_AA_ECDSA_MODULE=

# Server only, never NEXT_PUBLIC. The venue's order key. Defaults to anvil account 6 on local; required on fuji.
# VENUE_ORDER_KEY=
# Server only, never NEXT_PUBLIC: this URL embeds the paymaster key. Required on fuji.
# PAYMASTER_URL=https://paymaster.0xgasless.com/v1/43113/rpc/<key>
# Server only. Set to 1 on fuji so the unverified demo reaches the token hook instead of InvalidVenueSignature.
# VENUE_DEMO_COSIGN=1
