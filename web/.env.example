# local or fuji. Selects deployments/<chain>.json and the RPC. Read at build time, so on Vercel set it for the build too.
NEXT_PUBLIC_CHAIN=local
# Optional. Overrides the chain's default RPC.
# NEXT_PUBLIC_RPC_URL=

# Everything below is server only: never prefix it with NEXT_PUBLIC.

# The venue's order key. Defaults to anvil account 6 on local; required on fuji.
# VENUE_ORDER_KEY=
# The second venue's order key. Defaults to anvil account 8 on local; required on fuji for orders that name venue 2.
# It must match actors.orderKey2 in deployments/fuji.json.
# VENUE_ORDER_KEY_2=
# Set to 1 on fuji so the unverified demo reaches the token hook instead of InvalidVenueSignature.
# VENUE_DEMO_COSIGN=1

# Required on fuji, as a value or as a path. The value wins. Vercel has no files, so it sets the values;
# a local run can keep each secret in its own file outside the repo. The seed is testnet-only: never put a
# mnemonic that holds real funds here.
# MNEMONIC=
# ZEROXGASLESS_KEY=
# MNEMONIC_PATH=/path/to/seed
# ZEROXGASLESS_KEY_PATH=/path/to/0xgasless-key

# Required on fuji: the smart-account contracts, from spike/README.md, "Fuji addresses".
# AA_FACTORY=0xF0b3f5146c2725e36d78F5029bc560eDfc67ADe0
# AA_IMPLEMENTATION=0x8aF33bE7af021A6075aeB19b076fC75Bfbd2c5c3
# AA_FALLBACK_HANDLER=0xdA62055b0730d1d0621aD0A446DcD6057a6d951E
# AA_ECDSA_MODULE=0xcfb0BA514aa398085D63eC70cfEa6EC7f1094E8F
# Optional. Overrides the 0xGasless bundler.
# BUNDLER_URL=

# Set, every page and API route asks for HTTP Basic auth: any username, this password. Unset, there is no gate.
# DEMO_PASSWORD=

# Set, the venue's orders, refusals and reversions live in Upstash Redis; unset, in process memory.
# Serverless instances share no memory, so Vercel needs them. The Upstash integration injects both.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Optional. Replaces the "handoff" at the start of every key, to keep a test run apart.
# VENUE_STORE_PREFIX=
